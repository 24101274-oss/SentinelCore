# Los secretos van vacíos. Genera tokens y contraseña con: python -m lab.local --init-only
# AI_API_KEY es opcional: créala en console.groq.com y pon AI_ENABLED=true para usar la IA.
INGEST_TOKEN=
ADMIN_TOKEN=
LAB_USERNAME=admin
LAB_PASSWORD=
MEDIUM_THRESHOLD=3
HIGH_THRESHOLD=5
WINDOW_SECONDS=60
LAB_CIDRS=10.231.37.0/28
ALLOWLIST=10.231.37.1,10.231.37.2,10.231.37.3
AUTO_CONTAINMENT=true
BLOCK_SECONDS=60
MAX_ACTIVE_BLOCKS=20
PROTECTED_APP_PUBLIC_URL=http://127.0.0.1:8001

AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_MIN_CONFIDENCE=0.8
